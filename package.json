{
  "name": "react-native-pdf-editor",
  "version": "0.0.4",
  "description": "React Native PDF editor, powered by PoDoFo with PadES signing support.",
  "keywords": [
    "android",
    "ios",
    "react-native"
  ],
  "homepage": "https://github.com/Doko-Demo-Doa/react-native-pdf-editor#readme",
  "bugs": {
    "url": "https://github.com/Doko-Demo-Doa/react-native-pdf-editor/issues"
  },
  "license": "MIT",
  "author": "Quan Pham <phamvanquan@live.com> (https://github.com/Doko-Demo-Doa/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doko-Demo-Doa/react-native-pdf-editor.git"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-pdf-editor-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "example": "pnpm --filter react-native-pdf-editor-example",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:native": "./code-format.sh",
    "format:native:check": "./code-format.sh --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "release-it --only-version"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-plugin": "0.86.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.10",
    "commitlint": "^21.2.1",
    "del-cli": "^7.0.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-react-native": "^5.0.0",
    "lefthook": "^2.1.10",
    "nitrogen": "^0.36.1",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.43.0",
    "react-native-nitro-modules": "^0.36.1",
    "release-it": "^20.2.1",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-native": "^0.8.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "^0.36.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "pnpm@11.14.0",
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "oxlint",
      "vitest",
      "lefthook",
      "release-it"
    ],
    "version": "0.63.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  }
}
